---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { PremiumPreview } from '@/components/results/PremiumPreview';
import { messages } from '@/lib/localization/messages';
import type { Locale } from '@/types/model';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = messages[locale];
---
<BaseLayout locale={locale} path="/premium" title={`${m.premiumTitle} — NOEMA`} description={m.premiumBanner}>
  <PremiumPreview client:load locale={locale} />
</BaseLayout>
