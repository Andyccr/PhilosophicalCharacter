---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { AssessmentApp } from '@/components/assessment/AssessmentApp';
import { messages } from '@/lib/localization/messages';
import type { Locale } from '@/types/model';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = messages[locale];
---
<BaseLayout locale={locale} path="/test" title={`${m.questionnaire} — NOEMA`} description={m.heroNote}>
  <AssessmentApp client:load locale={locale} />
</BaseLayout>
