---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { archetypesInFamily } from '@/data/archetypes';
import { FAMILY_ORDER, families } from '@/data/archetypes/families';
import { messages } from '@/lib/localization/messages';
import { localePath } from '@/lib/localization/path';
import type { Locale } from '@/types/model';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = messages[locale];
---
<BaseLayout locale={locale} path="/types" title={`${m.archetypes} — NOEMA`} description={m.axesLead}>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <p class="kicker">{m.families}</p>
    <h1 class="serif mt-3 text-4xl md:text-6xl">{m.archetypes}</h1>
    <p class="mt-4 max-w-3xl">{m.axesLead}</p>
    {FAMILY_ORDER.map((id) => {
      const family = families[id];
      return (
        <section class="mt-12" id={id}>
          <h2 class="serif text-3xl"><a href={localePath(locale, `/families/${id}`)}>{family.name[locale]}</a></h2>
          <p class="mt-2 text-sm text-gold">{family.rule[locale]}</p>
          <p class="mt-3 max-w-3xl">{family.essay[locale]}</p>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {archetypesInFamily(id).map((archetype) => (
              <li class="border-t border-line pt-3">
                <a href={localePath(locale, `/types/${archetype.code.toLowerCase()}`)}>
                  <span class="mono text-xs text-iris">{archetype.code}</span>
                  <span class="mt-1 block serif text-xl">{archetype.name[locale]}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>
</BaseLayout>
