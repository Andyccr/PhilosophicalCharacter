---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { philosophers } from '@/data/philosophers/profiles';
import { getTradition } from '@/data/traditions/catalog';
import { dimensions } from '@/data/dimensions';
import { messages } from '@/lib/localization/messages';
import { absoluteUrl, localePath } from '@/lib/localization/path';
import type { Locale, Philosopher } from '@/types/model';

interface Props { locale: Locale; philosopher?: Philosopher }
const { locale, philosopher } = Astro.props;
const m = messages[locale];
---
{philosopher ? (
  <BaseLayout
    locale={locale}
    path={`/philosophers/${philosopher.slug}`}
    title={`${philosopher.name[locale]} — NOEMA`}
    description={philosopher.biography[locale].slice(0, 160)}
    jsonLd={[{
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: philosopher.name.en,
      alternateName: philosopher.name.zh,
      description: philosopher.biography[locale],
      url: absoluteUrl(localePath(locale, `/philosophers/${philosopher.slug}`)),
    }]}
  >
    <article class="mx-auto max-w-3xl px-4 py-12">
      <p class="kicker">{philosopher.dates[locale]}</p>
      <h1 class="serif mt-3 text-5xl">{philosopher.name[locale]}</h1>
      {philosopher.datesNote && <p class="mt-3 text-sm text-muted">{philosopher.datesNote[locale]}</p>}
      <p class="mt-6">{philosopher.biography[locale]}</p>
      <h2 class="serif mt-8 text-2xl">{m.alsoSee}</h2>
      <ul class="mt-3">{philosopher.themes.map((theme) => <li>{theme[locale]}</li>)}</ul>
      <h2 class="serif mt-8 text-2xl">{m.readingsTitle}</h2>
      <ul class="mt-3">{philosopher.works.map((work) => <li class="mt-3"><strong>{work.title[locale]}</strong> — {work.detail[locale]}</li>)}</ul>
      <h2 class="serif mt-8 text-2xl">{m.reflection}</h2>
      <ul class="mt-3 list-disc pl-5">{philosopher.questions.map((question) => <li>{question[locale]}</li>)}</ul>
      <p class="mt-6">{philosopher.readingNote[locale]}</p>
      <h2 class="serif mt-8 text-2xl">{m.dimensions}</h2>
      <ul>{philosopher.dimensions.map((id) => <li><a href={localePath(locale, `/philosophy/${id}`)}>{dimensions[id].plainName[locale]}</a></li>)}</ul>
      <h2 class="serif mt-8 text-2xl">{m.traditions}</h2>
      <ul>{philosopher.traditionSlugs.map((slug) => {
        const tradition = getTradition(slug);
        return tradition ? <li><a href={localePath(locale, `/traditions/${slug}`)}>{tradition.name[locale]}</a></li> : null;
      })}</ul>
      <h2 class="serif mt-8 text-2xl">{m.alsoSee}</h2>
      <ul>{philosopher.references.map((link) => <li><a href={link.href} rel="noreferrer noopener">{link.label}</a></li>)}</ul>
    </article>
  </BaseLayout>
) : (
  <BaseLayout locale={locale} path="/philosophers" title={`${m.philosophers} — NOEMA`} description={m.atlasLead}>
    <div class="mx-auto max-w-3xl px-4 py-12">
      <h1 class="serif text-5xl">{m.philosophers}</h1>
      <ul class="mt-8 grid gap-4">
        {philosophers.map((person) => (
          <li class="border-t border-line pt-4">
            <a class="serif text-2xl" href={localePath(locale, `/philosophers/${person.slug}`)}>{person.name[locale]}</a>
            <p class="text-sm text-muted">{person.dates[locale]}</p>
          </li>
        ))}
      </ul>
    </div>
  </BaseLayout>
)}
