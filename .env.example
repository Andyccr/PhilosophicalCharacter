# Leave this empty. Checkout is created by the Worker, not a public env flag.
PUBLIC_PAYMENT_PROVIDER=

# Worker secrets (set with wrangler, not in the client build):
# PAYPAL_CLIENT_ID
# PAYPAL_CLIENT_SECRET
# UNLOCK_HMAC_KEY
# PAYPAL_ENV=sandbox
# PAYMENTS_LIVE=false

# Optional. Cloudflare Web Analytics site token (public, not a secret).
# Get it from Cloudflare Dashboard → Analytics & Logs → Web Analytics → add a site
# (or open an existing site) → JS snippet / site token.
# Set it as a Workers Builds *build* variable on the `philosophicalcharacter` Worker.
# Leave empty to emit no beacon. The beacon is also skipped unless WORKERS_CI=1.
PUBLIC_CF_ANALYTICS_TOKEN=

# Optional. Override the canonical origin / asset base.
# Default origin is CLOUDFLARE_ORIGIN in src/lib/site.ts (the only place to change it).
# SITE=
# BASE_PATH=/
